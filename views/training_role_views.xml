<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_training_role_list" model="ir.ui.view">
        <field name="name">training.role.list</field>
        <field name="model">training.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_training_role_form" model="ir.ui.view">
        <field name="name">training.role.form</field>
        <field name="model">training.role</field>
        <field name="arch" type="xml">
            <form string="Cargo / Rol">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_role" model="ir.actions.act_window">
        <field name="name">Cargos / Roles</field>
        <field name="res_model">training.role</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
