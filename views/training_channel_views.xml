<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Lista -->

    <record id="view_training_channel_list" model="ir.ui.view">
        <field name="name">training.channel.list</field>
        <field name="model">training.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->

    <record id="view_training_channel_form" model="ir.ui.view">
        <field name="name">training.channel.form</field>
        <field name="model">training.channel</field>
        <field name="arch" type="xml">
            <form string="Canal">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->

    <record id="action_training_channel" model="ir.actions.act_window">
        <field name="name">Canales</field>
        <field name="res_model">training.channel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>