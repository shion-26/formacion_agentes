<odoo>

    <record id="view_registro_fi_pivot" model="ir.ui.view">
        <field name="name">registro_fi.pivot</field>
        <field name="model">registro_fi</field>
        <field name="arch" type="xml">
            <pivot string="Participantes">
                <field name="campania_id" type="row"/>
                <field name="grupo_formacion_id" type="row"/>
                <field name="estado_final" type="col"/>
                <field name="horas_formacion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_registro_fi_graph" model="ir.ui.view">
        <field name="name">registro_fi.graph</field>
        <field name="model">registro_fi</field>
        <field name="arch" type="xml">
            <graph string="Participantes por estado" type="bar">
                <field name="estado_final" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_registro_fi_report" model="ir.actions.act_window">
        <field name="name">Indicadores de participantes</field>
        <field name="res_model">registro_fi</field>
        <field name="view_mode">pivot,graph</field>
    </record>

</odoo>
