<odoo>

    <record id="view_training_entry_type_tree" model="ir.ui.view">
        <field name="name">training.entry.type.tree</field>
        <field name="model">training.entry.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_training_entry_type_form" model="ir.ui.view">
        <field name="name">training.entry.type.form</field>
        <field name="model">training.entry.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de ingreso">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_entry_type" model="ir.actions.act_window">
        <field name="name">Tipos de ingreso</field>
        <field name="res_model">training.entry.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
