<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_programacion_actividad_pivot" model="ir.ui.view">
        <field name="name">programacion.actividad.pivot</field>
        <field name="model">programacion.actividad</field>
        <field name="arch" type="xml">
            <pivot string="Actividades programadas por día">
                <field name="fecha_programada" type="row" interval="day"/>
                <field name="campania_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_programacion_actividad_report" model="ir.actions.act_window">
        <field name="name">Indicadores de programación</field>
        <field name="res_model">programacion.actividad</field>
        <field name="view_mode">pivot</field>
    </record>

</odoo>
