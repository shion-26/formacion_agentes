<odoo>

    <record id="view_training_campaign_tree" model="ir.ui.view">
        <field name="name">training.campaign.tree</field>
        <field name="model">training.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_training_campaign_form" model="ir.ui.view">
        <field name="name">training.campaign.form</field>
        <field name="model">training.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaña">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_campaign" model="ir.actions.act_window">
        <field name="name">Campañas</field>
        <field name="res_model">training.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
