<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="formacion_calidad.MmssTimeField">
        <div class="tt_field tt_field_mmss">

            <div class="tt_input_group">

                <input type="text"
                       t-attf-class="tt_input {{ state.error ? 'tt_input_error' : '' }}"
                       t-att-value="state.displayValue"
                       t-att-placeholder="props.placeholder || '00:00'"
                       t-on-keydown="onKeydown"
                       t-on-focus="onFocus"
                       readonly="readonly"/>

            </div>

            <div class="tt_error" t-if="state.error" t-esc="state.error"/>

        </div>
    </t>

</templates>
