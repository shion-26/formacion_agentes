<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_formacion" model="ir.module.category">
        <field name="name">Formación y Calidad</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_formacion_gestor" model="res.groups">
        <field name="name">Operador</field>
        <field name="category_id" ref="module_category_formacion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_formacion_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_formacion"/>
        <field name="implied_ids" eval="[(4, ref('group_formacion_gestor'))]"/>
    </record>

</odoo>
